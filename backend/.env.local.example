# ---- Local Mac demo (CPU whisper + Ollama) ----
# Copy to .env.local and `source` it, or export before running server.py.

# Small/fast ASR for CPU. Use "base" or "small". large-v3 is GPU-only really.
export RT_ASR_MODEL=small
export RT_ASR_DEVICE=cpu
export RT_ASR_COMPUTE=int8

# Ollama exposes an OpenAI-compatible API on :11434/v1
export RT_LLM_BASE_URL=http://localhost:11434/v1
export RT_LLM_MODEL=qwen3:8b
export RT_LLM_API_KEY=sk-no-key-required

# Anti-cut tuning. Raise MIN_SILENCE_MS if sentences still get split.
export RT_MIN_SILENCE_MS=900
export RT_MAX_SEGMENT_MS=12000
export RT_INTERIM_INTERVAL_MS=500
