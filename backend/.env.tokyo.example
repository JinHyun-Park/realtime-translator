# ---- Tokyo GPU box (ap-northeast-1) ----
# vLLM serves Qwen3-32B on :8000; faster-whisper large-v3 on the same GPU.

export RT_ASR_MODEL=large-v3
export RT_ASR_DEVICE=cuda
export RT_ASR_COMPUTE=float16

# vLLM OpenAI-compatible endpoint (started by deploy_tokyo.md).
export RT_LLM_BASE_URL=http://localhost:8000/v1
export RT_LLM_MODEL=Qwen/Qwen3-32B
export RT_LLM_API_KEY=sk-no-key-required

# Higher-quality endpointing. Tune to taste.
export RT_MIN_SILENCE_MS=1000
export RT_MAX_SEGMENT_MS=15000
export RT_INTERIM_INTERVAL_MS=400
export RT_HOST=0.0.0.0
export RT_PORT=8765
