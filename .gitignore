# Swift / SwiftPM
mac-app/.build/
mac-app/RealtimeTranslator.app/
# All built .dmg files — build artifacts; the "shared" flavor also bakes in a
# relay URL, so none of them belong in git.
mac-app/*.dmg
*.xcodeproj
.swiftpm/

# Python
backend/.venv/
**/__pycache__/
*.pyc

# Local env (may contain endpoints/keys)
backend/.env.local
backend/.env.tokyo

# Deploy state (environment-specific, not source)
deploy/.instance-id
deploy/.cloudfront-id

# OS
.DS_Store
deploy/.relay-token
deploy/.admin-token
deploy/.instance-id.big
deploy/.golden-ami
deploy/.eip-alloc
deploy/.wake-url

# Personal handoff notes — contains the relay token; never publish
HANDOFF.md

# Operator-only admin console — local-only, never in git or any build/dmg.
backend/admin_ext.py
backend/admin.html

# "shared" distribution material — bakes in MY relay URL + the access token.
# Local-only; never publish. (The dmg is already covered by mac-app/*.dmg.)
SHARED_*.md
*SHARED*.md
mac-app/SHARED_*
deploy/.shared-recipient
